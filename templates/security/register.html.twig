{% extends 'base.html.twig' %}
{% block title %}Register — Linkboard{% endblock %}
{% block body %}
<h1>Create an account</h1>
{{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.password) }}
    <button type="submit">Register</button>
{{ form_end(form) }}
<p><a href="{{ path('app_login') }}">Already registered? Log in</a></p>
{% endblock %}
