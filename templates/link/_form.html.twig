{{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.targetUrl) }}
    {% if form.slug is defined %}{{ form_row(form.slug) }}{% endif %}

    <details>
        <summary>UTM tags</summary>
        <div class="grid">
            {{ form_row(form.utmSource) }}
            {{ form_row(form.utmMedium) }}
            {{ form_row(form.utmCampaign) }}
        </div>
        <div class="grid">
            {{ form_row(form.utmTerm) }}
            {{ form_row(form.utmContent) }}
        </div>
    </details>

    <div class="grid">
        {{ form_row(form.expiresAt) }}
        {{ form_row(form.maxClicks) }}
    </div>
    {% if form.isActive is defined %}{{ form_row(form.isActive) }}{% endif %}

    <details {{ form.rules.vars.value.mode == 'raw' or form.rules.vars.errors|length ? 'open' }}>
        <summary>Routing rules</summary>
        <div data-controller="rules-editor">
            {{ form_errors(form.rules) }}
            {{ form_widget(form.rules.mode, {attr: {'data-rules-editor-target': 'mode'}}) }}
            <p>
                <button type="button" class="secondary outline"
                        data-rules-editor-target="toggle"
                        data-action="rules-editor#toggle">Edit as JSON</button>
            </p>

            <div data-rules-editor-target="structured">
                <div data-rules-editor-target="rows">
                    {% for row in form.rules.rows %}
                        <fieldset data-rules-editor-target="row">
                            <div class="grid">
                                {{ form_row(row.matchKey) }}
                                {{ form_row(row.values) }}
                                {{ form_row(row.target) }}
                            </div>
                            <button type="button" class="secondary outline" data-action="rules-editor#removeRow">Remove rule</button>
                        </fieldset>
                    {% endfor %}
                </div>
                <template data-rules-editor-target="template">
                    {{ form_widget(form.rules.rows.vars.prototype)|e('html_attr')|raw|replace({'__name__': '__index__'}) }}
                </template>
                <button type="button" class="secondary" data-action="rules-editor#addRow">Add rule</button>
                <p><small>One match key per rule here. A document with several keys in one rule, or with A/B variants, opens as JSON.</small></p>
            </div>

            <div data-rules-editor-target="raw" {{ form.rules.vars.value.mode == 'raw' ? '' : 'hidden' }}>
                {{ form_row(form.rules.raw, {attr: {'data-invalid': form.rules.raw.vars.errors|length ? 'true' : 'false'}}) }}
                <p><small>The whole document, as the API stores it. See <a href="/api/docs">the API documentation</a> for its shape.</small></p>
            </div>
        </div>
    </details>

    <button type="submit">{{ submit_label }}</button>
    <a href="{{ cancel_path }}" role="button" class="secondary outline">Cancel</a>
{{ form_end(form) }}
