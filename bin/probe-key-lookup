#!/usr/bin/env php
<?php

declare(strict_types=1);

// The database phase of the deep-probe authorization, run as a child process
// that the parent (App\Shared\Health\KeyLookupProcess) kills at its deadline —
// the only way to bound a PostgreSQL client *including its cleanup* when the
// server never answers (design decision 3 of authorize-deep-probe-by-api-key).
// No kernel, no autoloader: plain PDO from the DATABASE_URL environment
// variable. The key hash arrives on stdin (never argv or env: `ps` must not
// show it). Prints exactly one line and exits 0:
//   V <expires_at RFC 3339 | ->   an unrevoked, unexpired key of an unblocked ROLE_ADMIN
//   D                             the database answered: no such active admin key
//   U <exception class>           the database could not be reached or asked
// Option: --statement-timeout-ms=<n> (server-side belt; default 2500).

$statementTimeoutMs = 2500;
foreach (array_slice($argv, 1) as $arg) {
    if (1 === preg_match('/^--statement-timeout-ms=(\d+)$/', $arg, $m)) {
        $statementTimeoutMs = (int) $m[1];
    }
}

$hash = trim((string) stream_get_contents(STDIN));
if (1 !== preg_match('/^[0-9a-f]{64}$/', $hash)) {
    fwrite(STDOUT, "U InvalidHash\n");
    exit(0);
}

$url = getenv('DATABASE_URL');
$parts = false === $url ? false : parse_url($url);
if (false === $parts || !isset($parts['host'])) {
    fwrite(STDOUT, "U InvalidDatabaseUrl\n");
    exit(0);
}

try {
    $dsn = sprintf(
        "pgsql:host=%s;port=%d;dbname=%s;options='-c statement_timeout=%d'",
        $parts['host'],
        $parts['port'] ?? 5432,
        ltrim($parts['path'] ?? '', '/'),
        $statementTimeoutMs,
    );
    $pdo = new PDO($dsn, $parts['user'] ?? null, isset($parts['pass']) ? rawurldecode($parts['pass']) : null, [
        PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
        PDO::ATTR_TIMEOUT => 2, // libpq connect_timeout (its floor)
        // PQexecParams: real parameter binding in a single round trip, no
        // named server-side statement (one exchange to lose, not two)
        PDO::PGSQL_ATTR_DISABLE_PREPARES => true,
    ]);
    $statement = $pdo->prepare(
        'SELECT u.roles, u.is_blocked, k.revoked_at, k.expires_at FROM api_keys k JOIN users u ON u.id = k.user_id WHERE k.key_hash = :hash',
    );
    $statement->execute(['hash' => $hash]);
    $row = $statement->fetch(PDO::FETCH_ASSOC);
} catch (Throwable $e) {
    fwrite(STDOUT, 'U '.$e::class."\n");
    exit(0);
}

if (!is_array($row)) {
    fwrite(STDOUT, "D\n");
    exit(0);
}

$roles = json_decode((string) $row['roles'], true);
$isAdmin = is_array($roles) && in_array('ROLE_ADMIN', $roles, true);
$isBlocked = in_array($row['is_blocked'], [true, 't', 'true', '1', 1], true);
$now = new DateTimeImmutable();
$expiresAt = null === $row['expires_at'] ? null : new DateTimeImmutable((string) $row['expires_at']);

if (null !== $row['revoked_at'] || $isBlocked || !$isAdmin || (null !== $expiresAt && $expiresAt <= $now)) {
    fwrite(STDOUT, "D\n");
    exit(0);
}

fwrite(STDOUT, 'V '.($expiresAt?->format(DATE_ATOM) ?? '-')."\n");
exit(0);
