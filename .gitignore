# IDE
.idea/
.vscode/

# Local agent settings (personal permission overrides)
.claude/settings.local.json

# Machine-specific MCP endpoints (IDE instance ports)
.mcp.json
.codex/config.toml

# Env / secrets — never commit; reference by name
.env
.env.*
!.env.example

# OS / logs / caches
.DS_Store
*.log
.cache/
# PHP / Symfony
/vendor/
/var/
/public/bundles/
.phpunit.result.cache
.php-cs-fixer.cache
/phpstan.cache/
composer.phar
/config/secrets/*/*.decrypt.private.php
# Symfony convention overrides the template rule above: .env and .env.test
# are committed (defaults, no secrets); .env.local / .env.*.local stay ignored
!.env
!.env.test
