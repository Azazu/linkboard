# Build context for .docker/php/Dockerfile, which is the repository root so the
# production stage can copy the application in (design decision 1 of change
# stretch-public-hosting). Everything here is either regenerated inside the
# image, local state, or must never reach an image layer.

# Regenerated in the image: the production stage runs composer itself, with
# --no-dev, so a developer's tree (dev dependencies included) must not leak in.
/vendor/

# Local state: cache, logs, the GeoLite2 database, the demo share directory.
/var/

# Signing keys. Gitignored already; naming it here as well means a local
# keypair cannot reach a layer even if someone builds from a dirty tree.
/config/jwt/

# Every env file. `.env` and `.env.test` are committed and the application
# needs `.env` at runtime — it is copied explicitly by the production stage —
# but `.env.local` and friends are host secrets and never enter an image.
.env.local
.env.*.local

# History, tooling and editor state.
/.git/
/.github/
/.claude/
/.codex/
/.agents/
/.idea/
/.vscode/
.mcp.json

# Test and planning material: not needed to run the service.
/tests/
/openspec/
/docs/
/node_modules/

# Docker's own inputs: the compose files and this directory are configuration
# for the host, not for the image.
/docker-compose*.yml

# Generated by `assets:install` at container start into its own volume; a
# developer tree has its own copy and it must not become an image layer.
/public/bundles/
/public/assets/
