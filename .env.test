# Test environment defaults (committed; Symfony convention). CI and PHPUnit
# read this file. The test database is DATABASE_URL's database + "_test"
# (config/packages/doctrine.yaml, when@test dbname_suffix); Messenger uses
# in-memory transports (config/packages/messenger.yaml, when@test).
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# Debug off so error responses are tested as they leave production: no
# stack traces, generic detail (spec api-error-format).
APP_DEBUG=0

###> lexik/jwt-authentication-bundle ###
# test-only passphrase for the gitignored test keypair (config/jwt/test/)
JWT_PASSPHRASE=test-only-jwt-passphrase-not-a-secret
###< lexik/jwt-authentication-bundle ###
VISITOR_HASH_SALT=test-only-visitor-salt
# Country resolution in tests: the fixed IP→country map of tests/Fixture (design decision 8)
COUNTRY_RESOLVERS=fixed
