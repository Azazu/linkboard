# Symfony convention: this file IS committed and carries local-development
# DEFAULTS only — never a real secret. Machine-specific overrides and real
# credentials go to .env.local (gitignored); tests read .env.test. Docker
# Compose reads this file too (variable substitution + php env_file).
# Flex recipes append their variables here; review each addition before
# committing.
COMPOSE_PROJECT_NAME=linkboard
BIND_ADDRESS=127.0.0.1

# Host ports (kept off 80/5432/6379 to coexist with other local stacks)
APP_PORT=8082
FORWARD_DB_PORT=5434
FORWARD_REDIS_PORT=6382

###> symfony/framework-bundle ###
APP_ENV=dev
# Empty on purpose: dev gets its value from the committed .env.dev, prod from
# the real environment or Symfony secrets — never from this file.
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL generation outside HTTP (console commands); same origin as APP_PUBLIC_URL
DEFAULT_URI=http://localhost:8082
###< symfony/routing ###

TRUSTED_PROXIES=127.0.0.1

# PostgreSQL (compose + Doctrine; host is the service name inside the network)
DB_NAME=linkboard
DB_USER=linkboard
DB_PASSWORD=localdev-only-password
###> doctrine/doctrine-bundle ###
# Test database name = this one + "_test" (doctrine.yaml when@test dbname_suffix)
DATABASE_URL=postgresql://linkboard:localdev-only-password@postgres:5432/linkboard?serverVersion=16&charset=utf8
###< doctrine/doctrine-bundle ###

# Redis: cache, rate limiter, Messenger transport
REDIS_URL=redis://redis:6379
###> symfony/messenger ###
# Redis Streams transport for ClickRecorded (async); tests use in-memory (messenger.yaml when@test)
MESSENGER_TRANSPORT_DSN=redis://redis:6379/messages
###< symfony/messenger ###

# Public base URL used when rendering short links and QR codes (FR-LNK-11)
APP_PUBLIC_URL=http://localhost:8082

# Ids the php image runs as, so bind-mounted var/ and vendor/ stay yours.
# Not UID/GID: Bash reserves those names as read-only variables. Override
# from the shell if yours differ: HOST_UID=$(id -u) HOST_GID=$(id -g) make init
HOST_UID=1000
HOST_GID=1000

###> lexik/jwt-authentication-bundle ###
# Keys are per environment (config/jwt/<env>/, gitignored; `make jwt-keys`
# generates dev and test). The passphrase lives in .env.dev / .env.test for
# those environments and in the real environment in prod — never here.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/%kernel.environment%/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/%kernel.environment%/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/rate-limiter ###
# Requests per minute per client IP on /login, /register, /api/v1/auth/* (FR-AUTH-4)
RATE_LIMIT_AUTH_PER_IP=10
# Redirects per minute per client IP on GET /{slug} (FR-RED-6); fails open while Redis is down
RATE_LIMIT_REDIRECT_PER_IP=60
###< symfony/rate-limiter ###

###> symfony/lock ###
# Shared lock for the rate limiters (sliding window is read-modify-write on
# the cache; the lock makes it atomic across php-fpm workers and hosts)
LOCK_DSN=redis://redis:6379
###< symfony/lock ###

###> app/click-logging ###
# Salt of the click visitor_hash (FR-CLK-2). Local development default only:
# production sets VISITOR_HASH_SALT in .env.local (gitignored) or CI variables.
# Rotating it breaks unique-visitor continuity across the rotation.
VISITOR_HASH_SALT=localdev-only-salt-override-in-env-local
###< app/click-logging ###

###> routing rules (add-routing-rules) ###
# Country resolvers of the redirect, in order (FR-RUL-6): `header` reads the
# proxy header below and honours it only from TRUSTED_PROXIES; `geolite2` reads
# the local GeoLite2 database. An unknown name fails every application boot.
COUNTRY_RESOLVERS=header,geolite2
# Header a trusted proxy fills with the visitor's ISO 3166-1 alpha-2 country
GEOIP_COUNTRY_HEADER=CF-IPCountry
# GeoLite2-Country.mmdb downloaded by the operator (MaxMind account), never
# committed — var/ is gitignored. Missing file: one warning, country unknown.
GEOIP_DATABASE_PATH=%kernel.project_dir%/var/geoip/GeoLite2-Country.mmdb
###< routing rules ###
